const canonical = 'https://noyaru-stack-astro.netlify.app/a-propos';
// Reciprocal side of the hreflang pair whose /en counterpart carries the injected defect.
const alternates = [
  { lang: 'fr', href: 'https://noyaru-stack-astro.netlify.app/a-propos' },
  { lang: 'en', href: 'https://noyaru-stack-astro.netlify.app/en' },
  { lang: 'x-default', href: 'https://noyaru-stack-astro.netlify.app/a-propos' },
];
---
